# Backend Configuration for AutomationEDA

# Secret key for JWT token signing
AUTH_SECRET_KEY=automationeda-secret-key-2025

# Google Gemini API key (for AI-powered insights)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (fallback if Gemini is unavailable)
GROQ_API_KEY=your_groq_api_key_here

# Frontend origin(s) for CORS (comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:3000
